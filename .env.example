# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password   # used once to create the admin; remove afterwards

# Optional
DATABASE_SSL=true            # set if your provider requires SSL and the URL has no sslmode
CORS_ORIGINS=                # comma-separated origins; leave empty when the app is served by this server
PORT=3847

# Backups (set BACKUP_DIR to a persistent volume, otherwise redeploys erase them)
BACKUP_DIR=                  # e.g. /data/backups  (Railway/Render persistent disk)
BACKUP_KEEP=14               # newest backups kept per business
RESEND_API_KEY=              # optional: email backups
BACKUP_FROM_EMAIL=           # optional sender, e.g. MyBusinessHub <backups@yourdomain.com>
# ADMIN_RESET=true           # one-time admin password recovery (remove after login)
