# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password   # used once to create the admin; remove afterwards

# Optional
DATABASE_SSL=true            # set if your provider requires SSL and the URL has no sslmode
CORS_ORIGINS=                # comma-separated origins; leave empty when the app is served by this server
PORT=3847
